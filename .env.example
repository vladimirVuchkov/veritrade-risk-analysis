# Copy to .env to override the defaults used by docker-compose.yml and the scripts.
# Placeholder values only; never commit a real .env.

# RabbitMQ user for the services and the management UI (http://localhost:15672).
# Without a .env the user is veritrade/veritrade. Known weak passwords (veritrade, change-me, guest,
# empty) are accepted only with a loopback BIND_ADDRESS, and the rabbitmq container logs a WARNING.
# The password is stored in the rabbitmq-data volume on first start: after changing it, run
# docker compose down -v.
RABBITMQ_USERNAME=veritrade
RABBITMQ_PASSWORD=change-me

# Host address the UI and the management UI are published on. The default keeps both on loopback.
# Any other address (for example 0.0.0.0) requires a strong RABBITMQ_PASSWORD, or rabbitmq refuses
# to start.
BIND_ADDRESS=127.0.0.1

# Host ports. Only the UI and the RabbitMQ management UI are published.
UI_PORT=8080
RABBITMQ_MANAGEMENT_PORT=15672
