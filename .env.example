# Copy to .env to override the defaults used by docker-compose.yml and the scripts.
# Placeholder values only; never commit a real .env.

# RabbitMQ user for the services and the management UI (http://localhost:15672).
RABBITMQ_USERNAME=veritrade
RABBITMQ_PASSWORD=change-me

# Host ports. Only the UI and the RabbitMQ management UI are published.
UI_PORT=8080
RABBITMQ_MANAGEMENT_PORT=15672
