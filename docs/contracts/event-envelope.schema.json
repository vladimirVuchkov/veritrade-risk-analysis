{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritrade.example/contracts/event-envelope.schema.json",
  "title": "EventEnvelope",
  "description": "Common wrapper of every event on the veritrade.events exchange. Consumers ignore unknown fields (tolerant reader).",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid", "description": "Deterministic per (filingId, eventType); used for deduplication. Equals the AMQP messageId." },
    "eventType": { "type": "string", "enum": ["FILING_SUBMITTED", "ANALYSIS_STARTED", "ANALYSIS_COMPLETED", "ANALYSIS_FAILED"] },
    "eventVersion": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time", "description": "ISO-8601, UTC." },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "payload": { "type": "object" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "riskCategory": { "type": "string", "enum": ["FINANCIAL", "LEGAL", "OPERATIONAL", "CYBERSECURITY", "REGULATORY", "MARKET"] },
    "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "riskLevel": { "type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL"] }
  }
}
