{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritrade.example/contracts/analysis-failed.schema.json",
  "title": "AnalysisFailed",
  "description": "Published by Analysis with routing key analysis.failed when processing still fails after all retries. Terminal event.",
  "allOf": [{ "$ref": "event-envelope.schema.json" }],
  "properties": {
    "eventType": { "const": "ANALYSIS_FAILED" },
    "payload": {
      "type": "object",
      "required": ["filingId", "failedAt", "reason"],
      "properties": {
        "filingId": { "$ref": "event-envelope.schema.json#/$defs/uuid" },
        "failedAt": { "$ref": "event-envelope.schema.json#/$defs/timestamp" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
